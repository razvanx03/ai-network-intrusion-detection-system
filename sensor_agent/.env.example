# Bind on the private VM interface; restrict access to the backend host.
AGENT_HOST=0.0.0.0
AGENT_PORT=8000
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
API_KEY=
# Include both current/ and dated Zeek archives.
ZEEK_LOG_DIR=/opt/zeek/logs
# Persistent storage owned by the account running the collector (never /tmp).
STATE_FILE=/var/lib/nids-sensor/state.sqlite3
BATCH_SIZE=500
