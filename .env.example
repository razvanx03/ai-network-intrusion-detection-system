# ==========================================
# General App Configuration
# ==========================================
PROJECT_NAME="AI NIDS"
ENVIRONMENT=development
DEBUG=True
API_PREFIX=/api

# ==========================================
# Security & JWT Authentication
# ==========================================
# In production, generate a secure 32+ char key: openssl rand -hex 32
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# ==========================================
# Single Admin Seed Credentials
# ==========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ==========================================
# Database Configuration
# ==========================================
# SQLite default:
DATABASE_URL=sqlite:///./data/nids.db
# PostgreSQL alternative (uncomment if using PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/nids_db

# ==========================================
# CORS Configuration (Frontend URL)
# ==========================================
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ==========================================
# Remote Zeek Sensor VM Agent Integration
# ==========================================
# Set to True to use local simulated Zeek logs (no VM needed)
SENSOR_MOCK_MODE=True
SENSOR_AGENT_URL=http://192.168.56.101:8000
SENSOR_AGENT_API_KEY=nids-sensor-agent-secret-key

# ==========================================
# Frontend Configuration (Vite)
# ==========================================
VITE_API_BASE_URL=/api
